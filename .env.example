# DuplexVani Environment Configuration Template

# Official Gnani Vachana AI Voice Tokens (Obtain from https://app.gnani.ai or challenge portal)
GNANI_API_KEY=your_gnani_vachana_api_key_here

# Google Gemini Intelligence Brain (Obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Official Gnani Vachana Voice Endpoints
GNANI_PRISMA_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TIMBRE_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# Credit Shield Mode: Set to 'true' for local zero-credit dev; 'false' for live Gnani token inference
USE_SIMULATED_GNANI=false
