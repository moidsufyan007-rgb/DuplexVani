# DuplexVani Environment Configuration Template

# Gnani AI API Key (Obtain from https://app.gnani.ai)
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Voice Endpoints
GNANI_PRISMA_STT_URL=https://api.gnani.ai/v1/prisma/transcribe
GNANI_TIMBRE_TTS_URL=https://api.gnani.ai/v1/timbre/synthesize

# Mode Toggle: Set to 'true' to develop/test without consuming Gnani credits. Set to 'false' to call live APIs.
USE_SIMULATED_GNANI=true
